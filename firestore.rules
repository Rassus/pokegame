rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             (antiguo) sólo se deja borrar al borrar la cuenta
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   lbs/gold               top 50 con más oro ahora
//   lbs/tickets            top 50 con más tickets en total ahora
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Solo la cuenta dueña del apodo asus27. Puede borrar datos ajenos, no escribirlos.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/names/asus27).data.uid == me();
    }

    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow delete: if signedIn() && (me() == uid || isAdmin());

      allow create, update: if signedIn() && (me() == uid || isAdmin()) && validSaveDoc();
    }

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && (resource.data.uid == me() || (isAdmin() && lower != 'asus27'));
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || request.resource.data.best is map)
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me();
      allow update: if signedIn() && isAdmin() && uid != me()
        && resource.data.name == request.resource.data.name
        && resource.data.lower == request.resource.data.lower
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.at == request.time
        && request.resource.data.favs is list && request.resource.data.favs.size() == 0
        && request.resource.data.title == ''
        && request.resource.data.best is map && request.resource.data.best.size() == 0
        && request.resource.data.medals is list && request.resource.data.medals.size() == 0;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && (me() in resource.data.users || isAdmin());
    }

    // ---------- ranking ----------

    match /runs/{uid} {
      allow read: if signedIn() && me() == uid;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // Mejoras del Pokémon al hacer la marca (Vitalidad, Fuerza…). Una por compañero.
    function lvl(s, k, max) {
      return !(k in s) || (s[k] is int && s[k] >= 1 && s[k] <= max);
    }
    function validSheet(s) {
      return s == null || (s is map && s.size() <= 12
        && s.keys().hasOnly(['hp', 'atk', 'spd', 'cd', 'def', 'regen', 'magnet', 'xp', 'moves', 'crit', 'reroll', 'ban'])
        && lvl(s, 'hp', 40) && lvl(s, 'atk', 40) && lvl(s, 'spd', 8) && lvl(s, 'cd', 8)
        && lvl(s, 'def', 40) && lvl(s, 'regen', 10) && lvl(s, 'magnet', 12) && lvl(s, 'xp', 40)
        && lvl(s, 'moves', 1) && lvl(s, 'crit', 40) && lvl(s, 'reroll', 6) && lvl(s, 'ban', 3));
    }
    function validSheets(st, n) {
      return st is list && st.size() == n && st.size() <= 4
        && (st.size() < 1 || validSheet(st[0]))
        && (st.size() < 2 || validSheet(st[1]))
        && (st.size() < 3 || validSheet(st[2]))
        && (st.size() < 4 || validSheet(st[3]));
    }

    // Una entrada sólo se puede mejorar, nunca empeorar.
    // asus27 es la cuenta de pruebas: no puede dejar marca.
    function testerName(n) {
      return n is string && n.lower() == 'asus27';
    }
    function hasTester(names) {
      return names is list && (
        (names.size() > 0 && testerName(names[0]))
        || (names.size() > 1 && testerName(names[1]))
        || (names.size() > 2 && testerName(names[2]))
        || (names.size() > 3 && testerName(names[3]))
      );
    }

    function validEntry(board, id) {
      let d = request.resource.data;
      return !hasTester(d.names)
        && d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at', 'st'])
        && d.t is int && d.t > 0
        && d.lv is int && d.kills is int
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && (!('st' in d) || validSheets(d.st, d.uids.size()))
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || d.t > resource.data.t);
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || isAdmin());
    }

    // Resumen con el top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills, st } }
    //   me:  la fila que añades o mejoras (debe coincidir con tu marca validada,
    //        escrita en la misma transacción)
    //   ev:  la fila que sale del top (sólo si tiene menos tiempo que la tuya)
    // Al borrar la cuenta: me = '' y ev = una fila tuya que se quita.
    // lbs/gold y lbs/tickets: top 50 de lo que tienes ahora. La clave del mapa
    // es tu uid. Puedes entrar si superas al último, cambiar tu cifra (aunque
    // baje) o quitarte.
    function wealthRow(board, row) {
      return row is map
        && row.keys().hasOnly(['n', 'name', 'dex', 'shiny', 't1', 't10', 'tb', 'tg'])
        && row.n is int && row.n > 0 && row.n < 100000000000
        && row.name is string && row.name.size() >= 3 && row.name.size() <= 16
        && !testerName(row.name)
        && row.dex is int && row.dex >= 0 && row.dex < 2000
        && row.shiny is bool
        && row.t1 is int && row.t1 >= 0 && row.t1 < 1000000000
        && row.t10 is int && row.t10 >= 0 && row.t10 < 1000000000
        && row.tb is int && row.tb >= 0 && row.tb < 1000000000
        && row.tg is int && row.tg >= 0 && row.tg < 1000000000
        && (board == 'tickets'
            ? row.n == row.t1 + row.t10 + row.tb + row.tg
            : (row.t1 == 0 && row.t10 == 0 && row.tb == 0 && row.tg == 0));
    }
    function validWealth(board) {
      let d = request.resource.data;
      let old = resource == null || !('top' in resource.data) ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && ((d.me == '' && (d.ev == me() || isAdmin()) && d.ev in old && !(d.ev in d.top) && changed.hasOnly([d.ev]))
          || (d.me == me() && d.me in d.top && wealthRow(board, d.top[d.me])
            && (d.me in old
                ? (d.ev == '' && changed.hasOnly([d.me]))
                : (old.size() < 50
                    ? (d.ev == '' && changed.hasOnly([d.me]))
                    : (d.ev != me() && d.ev in old && !(d.ev in d.top)
                        && old[d.ev].n < d.top[d.me].n && changed.hasOnly([d.me, d.ev]))))));
    }

    function validTop(board) {
      return board == 'gold' || board == 'tickets' ? validWealth(board) : validBoard(board);
    }
    function validBoard(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? (removeMine(d, old, changed) || adminDrop(d, old, changed)) : addMine(board, d, old, changed));
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      return me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.st == e.st
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }
    function adminDrop(d, old, changed) {
      return isAdmin() && d.ev in old && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from || isAdmin());
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from || isAdmin());
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
